-- Универсальная функция создания переключателей (Toggle)
local function CreateToggle(name, yPos, initialVal, callback)
    local Btn = Instance.new("TextButton")
    Btn.Size = UDim2.new(1, -20, 0, 24)
    Btn.Position = UDim2.new(0, 10, 0, yPos)
    Btn.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
    Btn.Text = name .. (initialVal and ": ON" or ": OFF")
    Btn.TextColor3 = initialVal and Color3.fromRGB(0, 255, 100) or Color3.fromRGB(180, 180, 180)
    Btn.TextSize = 11
    Btn.Font = Enum.Font.Gotham
    Btn.Parent = MainFrame
    
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, 4)
    c.Parent = Btn
    
    local state = initialVal
    Btn.MouseButton1Click:Connect(function()
        state = not state
        Btn.Text = name .. (state and ": ON" or ": OFF")
        Btn.TextColor3 = state and Color3.fromRGB(0, 255, 100) or Color3.fromRGB(180, 180, 180)
        callback(state)
    end)
end

-- Создание ползунков (Sliders) для FOV
local function CreateSlider(name, yPos, min, val, max, callback)
    local Label = Instance.new("TextLabel")
    Label.Size = UDim2.new(1, -20, 0, 14)
    Label.Position = UDim2.new(0, 10, 0, yPos)
    Label.BackgroundTransparency = 1
    Label.Text = name .. ": " .. val
    Label.TextColor3 = Color3.fromRGB(200, 200, 200)
    Label.TextSize = 10
    Label.Font = Enum.Font.Gotham
    Label.TextXAlignment = Enum.TextXAlignment.Left
    Label.Parent = MainFrame

    local SliderBtn = Instance.new("TextButton")
    SliderBtn.Size = UDim2.new(1, -20, 0, 16)
    SliderBtn.Position = UDim2.new(0, 10, 0, yPos + 15)
    SliderBtn.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
    SliderBtn.Text = "Drag to change"
    SliderBtn.TextColor3 = Color3.fromRGB(150, 150, 150)
    SliderBtn.TextSize = 9
    SliderBtn.Font = Enum.Font.Gotham
    SliderBtn.Parent = MainFrame

    local sc = Instance.new("UICorner")
    sc.CornerRadius = UDim.new(0, 4)
    sc.Parent = SliderBtn

    local dragging = false
    SliderBtn.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)

    RunService.RenderStepped:Connect(function()
        if dragging then
            local mousePos = UserInputService:GetMouseLocation()
            local absPos = SliderBtn.AbsolutePosition
            local absSize = SliderBtn.AbsoluteSize
            local posPct = math.clamp((mousePos.X - absPos.X) / absSize.X, 0, 1)
            local currentVal = math.floor(min + (max - min) * posPct)
            Label.Text = name .. ": " .. currentVal
            callback(currentVal)
        end
    end)
end

