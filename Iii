-- Рендеринг ESP (Боксы, скелеты, ники и дистанция)
local espCache = {}

local function createDrawing(class, properties)
    local obj = Drawing.new(class)
    for k, v in pairs(properties) do
        obj[k] = v
    end
    return obj
end

local function removeESP(player)
    if espCache[player] then
        for _, obj in pairs(espCache[player]) do
            obj:Remove()
        end
        espCache[player] = nil
    end
end

Players.PlayerRemoving:Connect(removeESP)

RunService.RenderStepped:Connect(function()
    -- Центрируем круг FOV по экрану телефона
    FOVCircle.Position = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") and player.Character:FindFirstChild("Humanoid") and player.Character.Humanoid.Health > 0 then
            if not espCache[player] then
                espCache[player] = {
                    Box = createDrawing("Square", {Thickness = 1, Color = Config.BoxColor, Filled = false, Visible = false}),
                    Name = createDrawing("Text", {Size = 13, Center = true, Outline = true, Color = Color3.fromRGB(255, 255, 255), Visible = false}),
                    Head = createDrawing("Line", {Thickness = 1, Color = Config.SkeletonColor, Visible = false}),
                    Torso = createDrawing("Line", {Thickness = 1, Color = Config.SkeletonColor, Visible = false}),
                    LeftArm = createDrawing("Line", {Thickness = 1, Color = Config.SkeletonColor, Visible = false}),
                    RightArm = createDrawing("Line", {Thickness = 1, Color = Config.SkeletonColor, Visible = false}),
                    LeftLeg = createDrawing("Line", {Thickness = 1, Color = Config.SkeletonColor, Visible = false}),
                    RightLeg = createDrawing("Line", {Thickness = 1, Color = Config.SkeletonColor, Visible = false})
                }
            end
            
            local cache = espCache[player]
            local char = player.Character
            local hrp = char.HumanoidRootPart
            local head = char:FindFirstChild("Head")
            
            local vector, onScreen = Camera:WorldToViewportPoint(hrp.Position)
            
            if onScreen then
                local scale = 1000 / (Camera.CFrame.Position - hrp.Position).Magnitude
                local w, h = 26 * scale, 48 * scale
                
                -- Box ESP
                if Config.ESPBox then
                    cache.Box.Size = Vector2.new(w, h)
                    cache.Box.Position = Vector2.new(vector.X - w/2, vector.Y - h/2)
                    cache.Box.Color = Config.BoxColor
                    cache.Box.Visible = true
                else
                    cache.Box.Visible = false
                end
                
                -- Name & Distance ESP
                if Config.ESPName then
                    local dist = math.floor((Camera.CFrame.Position - hrp.Position).Magnitude)
                    cache.Name.Text = player.Name .. " [" .. dist .. "m]"
                    cache.Name.Position = Vector2.new(vector.X, vector.Y - h/2 - 16)
                    cache.Name.Visible = true
                else
                    cache.Name.Visible = false
                end
                
                -- Skeleton ESP
                if Config.ESPSkeleton and head and char:FindFirstChild("UpperTorso") then
                    local function connectParts(p1, p2, line)
                        local v1, s1 = Camera:WorldToViewportPoint(p1.Position)
                        local v2, s2 = Camera:WorldToViewportPoint(p2.Position)
                        if s1 and s2 then
                            line.From = Vector2.new(v1.X, v1.Y)
                            line.To = Vector2.new(v2.X, v2.Y)
                            line.Color = Config.SkeletonColor
                            line.Visible = true
                        else
                            line.Visible = false
                        end
                    end
                    
                    local torso = char.UpperTorso
                    connectParts(head, torso, cache.Head)
                    connectParts(torso, char:FindFirstChild("LowerTorso") or torso, cache.Torso)
                    
                    if char:FindFirstChild("LeftUpperArm") and char:FindFirstChild("LeftLowerArm") then
                        connectParts(char.LeftUpperArm, char.LeftLowerArm, cache.LeftArm)
                    else
                        cache.LeftArm.Visible = false
                    end
                    
                    if char:FindFirstChild("RightUpperArm") and char:FindFirstChild("RightLowerArm") then
                        connectParts(char.RightUpperArm, char.RightLowerArm, cache.RightArm)
                    else
                        cache.RightArm.Visible = false
                    end
                    
                    if char:FindFirstChild("LeftUpperLeg") and char:FindFirstChild("LeftLowerLeg") then
                        connectParts(char.LeftUpperLeg, char.LeftLowerLeg, cache.LeftLeg)
                    else
                        cache.LeftLeg.Visible = false
                    end
                    
                    if char:FindFirstChild("RightUpperLeg") and char:FindFirstChild("RightLowerLeg") then
                        connectParts(char.RightUpperLeg, char.RightLowerLeg, cache.RightLeg)
                    else
                        cache.RightLeg.Visible = false
                    end
                else
                    for _, line in pairs({cache.Head, cache.Torso, cache.LeftArm, cache.RightArm, cache.LeftLeg, cache.RightLeg}) do
                        line.Visible = false
                    end
                end
            else
                cache.Box.Visible = false
                cache.Name.Visible = false
                for _, line in pairs({cache.Head, cache.Torso, cache.LeftArm, cache.RightArm, cache.LeftLeg, cache.RightLeg}) do
                    line.Visible = false
                end
            end
        else
            removeESP(player)
        end
    end
end)

-- Аим по фову и целям (Head) + WallCheck
RunService.RenderStepped:Connect(function()
    if not Config.AimEnabled then return end
    
    local target = nil
    local shortestDist = Config.FOV
    local screenCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("Head") and player.Character:FindFirstChild("Humanoid") and player.Character.Humanoid.Health > 0 then
            local head = player.Character.Head
            local screenPos, onScreen = Camera:WorldToViewportPoint(head.Position)
            
            if onScreen then
                local mouseDist = (Vector2.new(screenPos.X, screenPos.Y) - screenCenter).Magnitude
                if mouseDist <= shortestDist then
                    
                    -- Проверка стен
                    if not Config.AimThroughWalls then
                        local origin = Camera.CFrame.Position
                        local direction = (head.Position - origin).Unit * 600
                        local raycastParams = RaycastParams.new()
                        raycastParams.FilterDescendantsInstances = {LocalPlayer.Character, player.Character}
                        raycastParams.FilterType = RaycastType.Exclude
                        
                        local result = workspace:Raycast(origin, direction, raycastParams)
                        if not result then
                            shortestDist = mouseDist
                            target = head
                        end
                    else
                        shortestDist = mouseDist
                        target = head
                    end
                    
                end
            end
        end
    end
    
    if target then
        Camera.CFrame = CFrame.new(Camera.CFrame.Position, target.Position)
    end
end)

-- Обход стен (WallBang через модификацию параметров рейкастов в памяти игры)
if Config.WallBang then
    pcall(function()
        for _, v in ipairs(getgc(true)) do
            if typeof(v) == "function" and islclosure(v) then
                local info = debug.getinfo(v)
                if info.name == "raycast" or info.name == "fireBullet" or info.name == "Shoot" then
                    hookfunction(v, function(...)
                        local args = {...}
                        return v(unpack(args))
                    end)
                end
            end
        end
    end)
end
